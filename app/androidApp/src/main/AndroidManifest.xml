<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".PartyApp"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <!-- Compose keeps its own state, so the activity is not recreated on rotation. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|density|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service android:name=".PushService" android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <!-- How Android shows push messages that arrive while the app is in the background. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="general" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification" />

        <!-- Crash reports go to the Sentry project partynearme-app. The DSN is public.
             Sentry starts itself from these values; screenshots, view hierarchies, tracing
             and personal data stay off (the defaults, spelled out here). -->
        <meta-data android:name="io.sentry.dsn" android:value="https://7a9348ef5e13ce90b731507e7b463137@o4512272125394944.ingest.de.sentry.io/4512272236609616" />
        <meta-data android:name="io.sentry.environment" android:value="${sentryEnvironment}" />
        <meta-data android:name="io.sentry.send-default-pii" android:value="false" />
        <meta-data android:name="io.sentry.attach-screenshot" android:value="false" />
        <meta-data android:name="io.sentry.attach-view-hierarchy" android:value="false" />
        <meta-data android:name="io.sentry.traces.user-interaction.enable" android:value="false" />
    </application>
</manifest>

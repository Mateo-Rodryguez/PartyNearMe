{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2023", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"jsx": "react-jsx",
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"isolatedModules": true,
		"verbatimModuleSyntax": true,
		"allowImportingTsExtensions": false,
		"types": ["vite/client"],
		"paths": { "#lib/*": ["./src/lib/*"] }
	},
	"include": ["src", "vite.config.ts", "vitest.config.ts"]
}

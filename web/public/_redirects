# App pages are drawn in the browser: they all boot from the app shell.
# The landing page (/) is built ahead as its own index.html.
# The target is /200, not /200.html: Pages redirects any .html address to its
# pretty form, so a rewrite to /200.html sends the browser to /200 and the app
# opens on the wrong page (a 404).
/feed           /200       200
/nearby         /200       200
/search         /200       200
/me             /200       200
/signin         /200       200
/auth/callback  /200       200
/e/*            /200       200
/p/*            /200       200
/u/*            /200       200
/new            /200       200
/notifications  /200       200
/settings       /200       200
/saved          /200       200
/chat           /200       200
/chat/*         /200       200
/host           /200       200
/feedback       /200       200
/moderation     /200       200

# The privacy policy and terms live on the API (it fills in the contact email),
# so meetbry.com/privacy and /terms send the browser there. These addresses go
# on the store listings, so they must keep working whatever serves them.
/privacy        https://partynearme-api.onrender.com/privacy  302
/terms          https://partynearme-api.onrender.com/terms    302

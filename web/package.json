{
	"name": "partynearme-web",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"tokens": "node scripts/tokens.mjs",
		"dev": "npm run tokens && vite dev",
		"build": "npm run tokens && vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "npm run tokens && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "npm run tokens && svelte-kit sync && vitest run"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"svelte": "^5.57.2",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"vitest": "^5.1.0"
	},
	"dependencies": {
		"blurhash": "^2.0.5"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"engines": {
		"node": ">=22"
	}
}

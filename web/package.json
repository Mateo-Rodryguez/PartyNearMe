{
	"name": "partynearme-web",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"tokens": "node scripts/tokens.mjs",
		"dev": "npm run tokens && vite",
		"build": "npm run tokens && tsc --noEmit && vite build && vite build --ssr src/prerender.tsx --outDir build-ssr && node scripts/shell.mjs",
		"preview": "vite preview",
		"check": "npm run tokens && tsc --noEmit",
		"test": "npm run tokens && vitest run"
	},
	"dependencies": {
		"blurhash": "^2.0.5",
		"maplibre-gl": "^6.17.0",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"react-router": "^7.18.5"
	},
	"devDependencies": {
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.3.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"vitest": "^5.1.0"
	},
	"engines": {
		"node": ">=22"
	}
}

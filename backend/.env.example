# Copy to .env for local development. Never commit .env.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
RATE_LIMIT_PER_MINUTE=120

# Supabase project URL (not secret): Project Settings > Data API.
SUPABASE_URL=https://vvkckzrhzgdrazhjitse.supabase.co

# Postgres connection string (secret, contains the database password):
# Project Settings > Database > Connection string > Transaction pooler.
# For local work against the test database: postgres://postgres@127.0.0.1:55432/postgres
DATABASE_URL=

# Cloudflare R2 photo storage. Uploads return 503 until all of these are set.
# Account ID: R2 overview page. Keys: R2 > Manage API tokens (secret).
R2_ACCOUNT_ID=
R2_BUCKET=partynearme-media
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Public URL photos are served from, e.g. https://media.partynearme.app
MEDIA_BASE_URL=

# Photo worker only: OpenAI key for omni-moderation (free endpoint).
OPENAI_API_KEY=

# Push notifications (optional): Firebase service account JSON on one line.
FIREBASE_SERVICE_ACCOUNT=
